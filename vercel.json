{
  "buildCommand": "cd campusgpt-frontend && npm install && CI=false npm run build",
  "outputDirectory": "campusgpt-frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
